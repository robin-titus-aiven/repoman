{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": false,
    "sourceMap": true,
    // rootDir spans both folders, so output lands at dist/server and dist/src
    // and the server's `../src/recipes.js` import resolves after compilation.
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": ["server/**/*.ts", "src/recipes.ts"]
}
