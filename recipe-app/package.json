{
  "name": "cucina-recipe-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsc -p tsconfig.server.json",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js"
  },
  "comment:react-aria": "Aquarium 6.8.2's prebuilt bundle imports the scoped @react-aria/* and @react-stately/* entry points, which react-aria no longer pulls in transitively. At their current versions these are thin re-exports over the react-aria monolith, so listing them here satisfies the bundle without duplicating the implementation.",
  "dependencies": {
    "@aivenio/aquarium": "^6.8.2",
    "@react-aria/button": "^3.15.1",
    "@react-aria/dialog": "^3.5.27",
    "@react-aria/i18n": "^3.12.14",
    "@react-aria/interactions": "^3.26.1",
    "@react-aria/label": "^3.7.20",
    "@react-aria/overlays": "^3.30.1",
    "@react-aria/tooltip": "^3.8.9",
    "@react-aria/utils": "^3.33.1",
    "@react-aria/visually-hidden": "^3.8.28",
    "@react-stately/overlays": "^3.7.1",
    "@react-stately/utils": "^3.10.9",
    "express": "^5.2.1",
    "lodash-es": "^4.17.21",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
